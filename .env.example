# =============================================================================
# Visual Intelligence Engine — configuration
# Copy to .env (scripts/install.sh does it and fills the secrets with random
# values). Never commit .env.
# =============================================================================

# ---- Network exposure -------------------------------------------------------
# The UI/API is published ONLY on this host address and port.
VIE_BIND_ADDRESS=127.0.0.1
VIE_PORT=8080

# ---- Secrets (generated by scripts/install.sh — do not reuse elsewhere) -----
POSTGRES_PASSWORD=__GENERATE__
VIE_SECRET_KEY=__GENERATE__
# Access key typed in the login screen of the web UI.
VIE_ACCESS_KEY=__GENERATE__

# ---- Profile ----------------------------------------------------------------
# lite = fits a 7.75 GB Docker VM shared with other stacks (default)
# advanced = bigger model + Docling (needs >= 16 GB in Docker Desktop)
VIE_PROFILE=lite

# ---- Multimodal model (Ollama) ---------------------------------------------
# Always use an "-instruct" tag: bare tags (qwen3-vl:2b) are the *thinking* variant.
VIE_VLM_MODEL=qwen3-vl:2b-instruct
# Models downloaded during the install phase (comma separated).
VIE_VLM_MODELS_TO_PULL=qwen3-vl:2b-instruct
VIE_VLM_NUM_CTX=4096
VIE_VLM_NUM_PREDICT=768
VIE_VLM_NUM_THREAD=6
# Longest side (px) of the image sent to the model (documents / camera).
VIE_VLM_MAX_SIDE_DOCUMENT=1280
VIE_VLM_MAX_SIDE_CAMERA=1024
# Max characters of OCR text included in the prompt.
VIE_VLM_MAX_OCR_CHARS=2500
VIE_VLM_TIMEOUT_S=300
VIE_VLM_TEMPERATURE=0
VIE_VLM_SEED=42
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# ---- OCR (RapidOCR + PaddleOCR PP-OCRv6 ONNX models baked in the image) -----
# small (lite) | medium (advanced)
VIE_OCR_MODEL_SIZE=small
VIE_OCR_THREADS=3

# ---- Upload / processing limits ----------------------------------------------
VIE_MAX_IMAGE_MB=20
VIE_MAX_PDF_MB=30
VIE_MAX_PDF_PAGES=30
VIE_MAX_VIDEO_MB=100
VIE_MAX_VIDEO_SECONDS=600
VIE_MAX_FILES_PER_REQUEST=10
VIE_MAX_IMAGE_PIXELS=120000000
VIE_WORK_IMAGE_MAX_SIDE=3000
VIE_JOB_TIMEOUT_S=600
VIE_STORAGE_QUOTA_GB=10
# 0 = keep everything. >0 = purge items in the trash older than N days.
VIE_RETENTION_DAYS=0

# ---- Camera -----------------------------------------------------------------
VIE_CAMERA_MIN_OCR_INTERVAL_S=3
VIE_CAMERA_MIN_VLM_INTERVAL_S=60
VIE_CAMERA_AUTO_VLM=false

# ---- Resource limits (lite profile; total ~4.9 GB) ---------------------------
VIE_OLLAMA_CPUS=6
VIE_OLLAMA_MEM=3328m
VIE_VISION_CPUS=3
VIE_VISION_MEM=768m
VIE_WORKER_CPUS=1.5
VIE_WORKER_MEM=320m
VIE_API_CPUS=1.5
VIE_API_MEM=288m
VIE_DB_CPUS=1
VIE_DB_MEM=256m
VIE_FRONTEND_CPUS=0.5
VIE_FRONTEND_MEM=48m

# ---- Logging ----------------------------------------------------------------
VIE_LOG_LEVEL=INFO
